generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id              String   @id @default(cuid())
  // `title`: dipakai untuk <title> tag (SEO, dapat suffix "| Blog Falya" di
  // layer template) dan basis slug. BUKAN untuk H1 — pakai `headline`.
  title           String
  slug            String   @unique
  content         String   @db.Text
  // `headline`: H1 murni yang tampil di halaman artikel, tanpa suffix brand.
  // Nullable untuk kompatibilitas data lama; render selalu fallback ke
  // `title` kalau kosong (lihat app/blog/[slug]/page.tsx).
  headline        String?  @db.Text
  // `metaDescription`: <meta name="description">, OG description, Twitter
  // description. BUKAN kutipan yang tampil di halaman — pakai `excerpt`.
  metaDescription String?  @db.Text
  // `excerpt`: kutipan singkat yang tampil di halaman artikel (di bawah H1).
  // Nullable untuk kompatibilitas data lama; render fallback ke
  // `metaDescription` kalau kosong.
  excerpt         String?  @db.Text
  category        String?
  imageUrl        String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Akan disimpan dalam bentuk hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// Laporan audit SEO mingguan dari Agent "SEO Auditor" (Karyawan AI,
// `python -m falya_crew.seo_audit`). Skema pragmatis untuk iterasi pertama:
// payload penuh disimpan sebagai JSON (`reportJson`, shape = SeoAuditReport
// Pydantic model di Karyawan AI/src/falya_crew/models.py, snake_case apa
// adanya), sementara beberapa kolom ringkasan di-denormalisasi supaya
// list/filter di /admin/seo cepat tanpa parse JSON per baris. TIDAK
// dinormalisasi penuh (broken link / meta issue / pagespeed score jadi
// tabel terpisah) karena: (1) audit-only, belum ada aksi per-row
// (approve/fix) yang butuh relasi, (2) shape Pydantic masih bisa berubah
// di iterasi berikutnya (auto-fix, keyword-gap Agent 4) -- JSON blob
// menghindari migrasi Prisma tiap kali field baru ditambah di sisi Python.
model SeoAuditReport {
  id                  String   @id @default(cuid())
  generatedAt         DateTime
  websiteBaseUrl      String
  totalBrokenLinks    Int      @default(0)
  totalMetaIssues     Int      @default(0)
  avgPerformanceScore Float?
  totalClicks28d      Int?
  totalImpressions28d Int?
  reportJson          Json
  createdAt           DateTime @default(now())

  @@index([generatedAt])
}

// Usulan fix otomatis dari audit SEO -- SAAT INI HANYA untuk
// Post.metaDescription yang kosong (satu-satunya isu yang punya target
// tulis aman & nilai fallback resmi, lihat cleanExcerpt di lib/utils.ts).
// Butuh approval admin sebelum diterapkan (lihat agents.md bagian 7). Tanpa
// @relation Prisma -- konsisten dengan model lain di file ini, join
// dilakukan di kode aplikasi (lihat app/actions/seo.ts).
model SeoProposedFix {
  id            String    @id @default(cuid())
  auditReportId String
  postId        String
  // "metaDescription" -- string (bukan enum) supaya field lain gampang
  // ditambah nanti tanpa migrasi enum.
  field         String
  issueType     String
  currentValue  String?   @db.Text
  proposedValue String    @db.Text
  // "pending" | "approved" | "applied" | "rejected"
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status])
  @@index([postId])
}

model MenuItem {
  // Id manual (bukan @default(cuid())) supaya id lama dari seed data
  // (mis. "risol001") tetap terjaga; item baru dari admin memakai cuid().
  id          String   @id
  name        String
  // Kategori disimpan sebagai String (bukan enum Prisma) supaya menambah
  // kategori baru dari kode tidak perlu migrasi skema — validasi union
  // type tetap dijaga di sisi TypeScript (lihat lib/data/menuData.ts).
  category    String
  price       Int
  description String   @db.Text
  image       String
  unit        String?
  isPopular   Boolean  @default(false)
  isAvailable Boolean  @default(true)
  // Di-set oleh Agent "Website Sync" (crew Python di folder Karyawan AI)
  // berdasarkan ranking revenue 30 hari terakhir dari data penjualan app
  // kasir — BUKAN dikurasi manual seperti isPopular. Lihat
  // app/api/admin/products/bestseller/route.ts.
  isBestseller Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

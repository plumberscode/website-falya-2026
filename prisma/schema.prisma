generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  metaDescription String?  @db.Text
  category        String?
  imageUrl        String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Akan disimpan dalam bentuk hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model MenuItem {
  // Id manual (bukan @default(cuid())) supaya id lama dari seed data
  // (mis. "risol001") tetap terjaga; item baru dari admin memakai cuid().
  id          String   @id
  name        String
  // Kategori disimpan sebagai String (bukan enum Prisma) supaya menambah
  // kategori baru dari kode tidak perlu migrasi skema — validasi union
  // type tetap dijaga di sisi TypeScript (lihat lib/data/menuData.ts).
  category    String
  price       Int
  description String   @db.Text
  image       String
  unit        String?
  isPopular   Boolean  @default(false)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id              String   @id @default(cuid())
  // `title`: dipakai untuk <title> tag (SEO, dapat suffix "| Blog Falya" di
  // layer template) dan basis slug. BUKAN untuk H1 — pakai `headline`.
  title           String
  slug            String   @unique
  content         String   @db.Text
  // `headline`: H1 murni yang tampil di halaman artikel, tanpa suffix brand.
  // Nullable untuk kompatibilitas data lama; render selalu fallback ke
  // `title` kalau kosong (lihat app/blog/[slug]/page.tsx).
  headline        String?  @db.Text
  // `metaDescription`: <meta name="description">, OG description, Twitter
  // description. BUKAN kutipan yang tampil di halaman — pakai `excerpt`.
  metaDescription String?  @db.Text
  // `excerpt`: kutipan singkat yang tampil di halaman artikel (di bawah H1).
  // Nullable untuk kompatibilitas data lama; render fallback ke
  // `metaDescription` kalau kosong.
  excerpt         String?  @db.Text
  category        String?
  imageUrl        String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Akan disimpan dalam bentuk hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// Laporan audit SEO mingguan dari Agent "SEO Auditor" (Karyawan AI,
// `python -m falya_crew.seo_audit`). Skema pragmatis untuk iterasi pertama:
// payload penuh disimpan sebagai JSON (`reportJson`, shape = SeoAuditReport
// Pydantic model di Karyawan AI/src/falya_crew/models.py, snake_case apa
// adanya), sementara beberapa kolom ringkasan di-denormalisasi supaya
// list/filter di /admin/seo cepat tanpa parse JSON per baris. TIDAK
// dinormalisasi penuh (broken link / meta issue / pagespeed score jadi
// tabel terpisah) karena: (1) audit-only, belum ada aksi per-row
// (approve/fix) yang butuh relasi, (2) shape Pydantic masih bisa berubah
// di iterasi berikutnya (auto-fix, keyword-gap Agent 4) -- JSON blob
// menghindari migrasi Prisma tiap kali field baru ditambah di sisi Python.
model SeoAuditReport {
  id                  String   @id @default(cuid())
  generatedAt         DateTime
  websiteBaseUrl      String
  totalBrokenLinks    Int      @default(0)
  totalMetaIssues     Int      @default(0)
  avgPerformanceScore Float?
  totalClicks28d      Int?
  totalImpressions28d Int?
  reportJson          Json
  createdAt           DateTime @default(now())

  @@index([generatedAt])
}

// Usulan fix otomatis dari audit SEO -- SAAT INI HANYA untuk
// Post.metaDescription yang kosong (satu-satunya isu yang punya target
// tulis aman & nilai fallback resmi, lihat cleanExcerpt di lib/utils.ts).
// Butuh approval admin sebelum diterapkan (lihat agents.md bagian 7). Tanpa
// @relation Prisma -- konsisten dengan model lain di file ini, join
// dilakukan di kode aplikasi (lihat app/actions/seo.ts).
model SeoProposedFix {
  id            String    @id @default(cuid())
  auditReportId String
  postId        String
  // "metaDescription" -- string (bukan enum) supaya field lain gampang
  // ditambah nanti tanpa migrasi enum.
  field         String
  issueType     String
  currentValue  String?   @db.Text
  proposedValue String    @db.Text
  // "pending" | "approved" | "applied" | "rejected"
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status])
  @@index([postId])
}

// Antrian permintaan artikel AI dari /admin/blog (Agent 4 -- Content
// Writer, Karyawan AI). Next.js (Vercel) tidak bisa menyalakan proses
// Python di laptop langsung, jadi tombol "Minta Artikel Baru (AI)" cuma
// bikin baris "pending" di sini -- draft artikel BENERAN dibuat saat
// `python -m falya_crew.content_writer` dijalankan manual dari laptop
// (kapan saja setelahnya), yang mengecek tabel ini lewat
// GET /api/admin/content/next-job lalu menandainya "done" lewat
// POST /api/admin/content/draft. Tanpa @relation, konsisten dengan model
// lain di file ini.
model ContentJobRequest {
  id           String    @id @default(cuid())
  // "pending" | "done"
  status       String    @default("pending")
  // Arahan tema opsional dari admin (mis. "tulis soal snack box untuk
  // acara kantor") -- kalau kosong, agent pilih topik sendiri dari data
  // produk laris + keyword gap, sama seperti perilaku sebelumnya.
  instruction  String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  resultPostId String?

  @@index([status])
}

// Log eksekusi tiap run agent Python (Karyawan AI: sales_sync, seo_audit,
// content_writer). Satu run = SATU row, update-in-place: POST pertama
// (status=running) create row & return run_id; POST kedua (status=success|
// error) update row yang sama pakai run_id (bukan insert row kedua). Ini
// bikin query "run terakhir" sederhana (findFirst by agentName order
// startedAt desc). Tanpa @relation, konsisten dengan model lain di file
// ini. Lihat app/api/admin/agents/run-log/route.ts.
model AgentRunLog {
  id               String    @id @default(cuid())
  // "sales_sync" | "seo_audit" | "content_writer"
  agentName        String
  // "running" | "success" | "error"
  status           String
  summary          String?
  errorMessage     String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  startedAt        DateTime
  finishedAt       DateTime?

  @@index([agentName])
  @@index([agentName, status])
  @@index([startedAt])
}

// Checklist roadmap manual di /admin/agents Section 6 -- CATATAN admin
// sendiri, BUKAN data otomatis dari agent (tidak ada penulis lain selain
// UI dashboard ini). Sengaja model paling sederhana di file ini.
model AgentRoadmapNote {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Antrian instruksi ad-hoc dari /admin/agents untuk Sales Sync & SEO
// Auditor -- generalisasi dari ContentJobRequest (Agent 4), TAPI SENGAJA
// tabel terpisah, BUKAN merge/rename ContentJobRequest: Agent 4 sudah
// production (dipoll content_main.py, ditulis next-job/draft route, dipakai
// UI /admin/blog) dan merge tidak memberi keuntungan fungsional apapun,
// cuma risiko regresi. content_writer TETAP pakai ContentJobRequest apa
// adanya -- lihat plan implementasi dashboard /admin/agents.
//
// Beda dari ContentJobRequest: sales_sync & seo_audit TIDAK di-gate
// eksekusinya oleh ada/tidaknya row pending di sini (crew tetap jalan kalau
// dipicu manual, dengan atau tanpa instruksi) -- instruction cuma
// diteruskan sebagai extra input kalau ADA yang pending. Tanpa @relation,
// konsisten dengan model lain di file ini.
model AgentTaskRequest {
  id          String    @id @default(cuid())
  // "sales_sync" | "seo_audit" (BUKAN "content_writer", lihat komentar di atas)
  agentName   String
  instruction String?
  // "pending" | "processed" | "error"
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([agentName, status])
}

model MenuItem {
  // Id manual (bukan @default(cuid())) supaya id lama dari seed data
  // (mis. "risol001") tetap terjaga; item baru dari admin memakai cuid().
  id           String   @id
  name         String
  // Kategori disimpan sebagai String (bukan enum Prisma) supaya menambah
  // kategori baru dari kode tidak perlu migrasi skema — validasi union
  // type tetap dijaga di sisi TypeScript (lihat lib/data/menuData.ts).
  category     String
  price        Int
  description  String   @db.Text
  image        String
  unit         String?
  isPopular    Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  // Di-set oleh Agent "Website Sync" (crew Python di folder Karyawan AI)
  // berdasarkan ranking revenue 30 hari terakhir dari data penjualan app
  // kasir — BUKAN dikurasi manual seperti isPopular. Lihat
  // app/api/admin/products/bestseller/route.ts.
  isBestseller Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

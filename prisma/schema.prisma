generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id              String   @id @default(cuid())
  // `title`: dipakai untuk <title> tag (SEO, dapat suffix "| Blog Falya" di
  // layer template) dan basis slug. BUKAN untuk H1 — pakai `headline`.
  title           String
  slug            String   @unique
  content         String   @db.Text
  // `headline`: H1 murni yang tampil di halaman artikel, tanpa suffix brand.
  // Nullable untuk kompatibilitas data lama; render selalu fallback ke
  // `title` kalau kosong (lihat app/blog/[slug]/page.tsx).
  headline        String?  @db.Text
  // `metaDescription`: <meta name="description">, OG description, Twitter
  // description. BUKAN kutipan yang tampil di halaman — pakai `excerpt`.
  metaDescription String?  @db.Text
  // `excerpt`: kutipan singkat yang tampil di halaman artikel (di bawah H1).
  // Nullable untuk kompatibilitas data lama; render fallback ke
  // `metaDescription` kalau kosong.
  excerpt         String?  @db.Text
  category        String?
  imageUrl        String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Akan disimpan dalam bentuk hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model MenuItem {
  // Id manual (bukan @default(cuid())) supaya id lama dari seed data
  // (mis. "risol001") tetap terjaga; item baru dari admin memakai cuid().
  id          String   @id
  name        String
  // Kategori disimpan sebagai String (bukan enum Prisma) supaya menambah
  // kategori baru dari kode tidak perlu migrasi skema — validasi union
  // type tetap dijaga di sisi TypeScript (lihat lib/data/menuData.ts).
  category    String
  price       Int
  description String   @db.Text
  image       String
  unit        String?
  isPopular   Boolean  @default(false)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
